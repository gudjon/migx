#!/usr/bin/env python3
"""Executable entry point for the migx CLI — `tools/migx-cli/migx <command>`.

Keeps the package importable without installing anything or setting PYTHONPATH.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from migx_cli.__main__ import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
